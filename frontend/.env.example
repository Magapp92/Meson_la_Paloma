# Plantilla de las variables del frontend. Copia este archivo como .env.local y ajusta los valores.

# Dirección de la API (en local, la API arranca en el puerto 4000)
# API_URL la leen los componentes de servidor (la Carta)
API_URL=http://localhost:4000/api
# NEXT_PUBLIC_API_URL la lee el navegador (el formulario de reserva). Next solo pasa al navegador las que empiezan por NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=http://localhost:4000/api
