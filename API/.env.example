# Plantilla de las variables de la API. Copia este archivo como .env y rellena los valores.
# El .env no se sube a GitHub (está en el .gitignore); este .env.example sí, sin datos privados.

# Entorno: development en tu ordenador, production en el servidor.
# En production la API no arranca si falta MONGO_URI, BREVO_API_KEY, MAIL_FROM o SITE_URL; en development solo avisa
NODE_ENV=development

# Puerto en el que arranca la API
PORT=4000

# Cadena de conexión a MongoDB Atlas (este valor es un ejemplo inventado: pon la de tu cluster)
MONGO_URI=mongodb+srv://usuario:contraseña@cluster.ejemplo.mongodb.net/meson-la-paloma

# Clave de la API de Brevo para enviar correos (se crea en Brevo > SMTP y API > Claves API)
BREVO_API_KEY=

# Correo del remitente (tiene que estar verificado en Brevo como remitente)
MAIL_FROM=

# Nombre que aparece como remitente del correo
MAIL_FROM_NAME=Mesón La Paloma

# Dirección de la web, sin barra al final: para el enlace de "Mi reserva" del correo
# y para CORS (solo esta web puede llamar a la API desde el navegador)
SITE_URL=http://localhost:3000
